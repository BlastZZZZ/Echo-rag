# Copy this file to `.env` and edit local values.
# `.env` is ignored by git and must not be committed.

# Local vLLM example:
OPENAI_API_KEY=EMPTY
LLM_BASE_URL=http://localhost:8002/v1
LLM_NAME=qwen3-8b

# Remote OpenAI-compatible API example:
# OPENAI_API_KEY=sk-your-key
# LLM_BASE_URL=https://api.example.com/v1
# LLM_NAME=qwen-plus

# The runner passes this value to scripts that accept --api_key/--api-key.
# ENV means "read OPENAI_API_KEY from the environment".
API_KEY_ARG=ENV

# Embedding setup. Leave EMBEDDING_BASE_URL empty for local SentenceTransformers.
EMBEDDING_NAME=Transformers/BAAI/bge-m3
EMBEDDING_BASE_URL=

# Optional selector override for scripts/run_musique_selector_smoke.sh.
# SELECTOR_MODEL=qwen3-8b
# SELECTOR_BASE_URL=http://localhost:8002/v1
